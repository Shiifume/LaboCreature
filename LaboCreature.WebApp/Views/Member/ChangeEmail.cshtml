@model LaboCreature.WebApp.Models.Members.MemberUpdateEmailForm

@{
    ViewData["Title"] = "Change Email";
}

<div class="game-container">

    <h1 class="game-title">Change Email</h1>

    <div class="game-panel">

        <h2 class="game-subtitle">Update your email address</h2>

        <div class="game-divider"></div>

        <form asp-action="ChangeEmail" method="POST">

            <div asp-validation-summary="ModelOnly" class="game-validation-summary"></div>

            <div class="game-form-group">
                <label asp-for="NewEmail" class="game-label"></label>
                <input asp-for="NewEmail" class="game-input" />
                <span asp-validation-for="NewEmail" class="game-validation-message"></span>
            </div>

            <div class="game-form-group">
                <label asp-for="Password" class="game-label"></label>
                <input asp-for="Password" class="game-input" />
                <span asp-validation-for="Password" class="game-validation-message"></span>
            </div>

            <div class="game-divider"></div>

            <div class="game-form-actions">
                <button type="submit" class="game-button">
                    Change Email
                </button>
            </div>

        </form>

    </div>

    <div class="member-profile-navigation">
        <a asp-action="Details" class="game-button-secondary">
            Cancel
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
