@model LaboCreature.WebApp.Models.Members.MemberUpdatePasswordForm

@{
    ViewData["Title"] = "Change Password";
}

<div class="game-container">

    <h1 class="game-title">Change Password</h1>

    <div class="game-panel">

        <h2 class="game-subtitle">Update your password</h2>

        <div class="game-divider"></div>

        <form asp-action="ChangePassword" method="post">

            <div asp-validation-summary="ModelOnly" class="game-validation-summary"></div>

            <div class="game-form-group">
                <label asp-for="CurrentPassword" class="game-label"></label>
                <input asp-for="CurrentPassword" class="game-input" type="password" />
                <span asp-validation-for="CurrentPassword" class="game-validation-message"></span>
            </div>

            <div class="game-form-group">
                <label asp-for="NewPassword" class="game-label"></label>
                <input asp-for="NewPassword" class="game-input" type="password" />
                <span asp-validation-for="NewPassword" class="game-validation-message"></span>
            </div>

            <div class="game-form-group">
                <label asp-for="NewPasswordConfirm" class="game-label"></label>
                <input asp-for="NewPasswordConfirm" class="game-input" type="password" />
                <span asp-validation-for="NewPasswordConfirm" class="game-validation-message"></span>
            </div>

            <div class="game-divider"></div>

            <div class="game-form-actions">
                <button type="submit" class="game-button">
                    Change Password
                </button>
            </div>

        </form>

    </div>

    <div class="member-profile-navigation">
        <a asp-action="Details" class="game-button-secondary">
            Cancel
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
