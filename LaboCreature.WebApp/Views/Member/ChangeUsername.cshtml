@model LaboCreature.WebApp.Models.Members.MemberUpdateUsernameForm

@{
    ViewData["Title"] = "Username Change";
}

<div class="game-container">

    <h1 class="game-title">@ViewData["Title"]</h1>

    <div class="game-panel">

        <h2 class="game-subtitle">Choose a new username</h2>

        <div class="game-divider"></div>

        <form asp-action="ChangeUsername" method="POST">

            <div asp-validation-summary="ModelOnly" class="game-validation-summary"></div>

            <div class="game-form-group">
                <label asp-for="NewUsername" class="game-label"></label>

                <input asp-for="NewUsername"
                       class="game-input"
                       id="username" />

                <span asp-validation-for="NewUsername"
                      class="game-validation-message"></span>

                <span id="usernameAvailability" class="game-text"></span>
            </div>

            <div class="game-form-group">
                <label asp-for="Password" class="game-label">
                    Password Confirmation
                </label>

                <input asp-for="Password"
                       class="game-input"
                       type="password" />

                <span asp-validation-for="Password"
                      class="game-validation-message"></span>
            </div>

            <div class="game-divider"></div>

            <div class="game-form-actions">
                <button type="submit" class="game-button">
                    Change Username
                </button>
            </div>

        </form>

    </div>

    <div class="member-profile-navigation">
        <a asp-action="Details" class="game-button-secondary">
            Cancel
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/usernameAvailability.js"></script>
}
