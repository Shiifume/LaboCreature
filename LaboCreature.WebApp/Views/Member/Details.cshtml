@model LaboCreature.WebApp.Models.Members.MemberView

@{
    ViewData["Title"] = "Member Profile";
}

<h1>Member Profile</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Username)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Username)
        </dd>
        <dd>
            <a asp-action="ChangeUsername" asp-controller="Member">Change username</a>
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dd>
            <a asp-action="ChangeEmail" asp-controller="Member">Change email</a>
        </dd>
    </dl>
    <dl>
        <dd>
            <a asp-action="ChangePassword" asp-controller="Member">Change password</a>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index" asp-controller="Home">Back to Home</a>
</div>
