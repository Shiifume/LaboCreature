@model LaboCreature.WebApp.Models.Members.MemberView

@{
    ViewData["Title"] = "Member Profile";
}

<div class="game-container">

    <h1 class="game-title">Member Profile</h1>

    <div class="game-panel">

        <h2 class="game-subtitle">Account Information</h2>

        <div class="game-divider"></div>

        <div class="member-profile-row">
            <div class="member-profile-info">
                <span class="game-label">
                    @Html.DisplayNameFor(model => model.Username)
                </span>
                <span class="game-text">
                    @Html.DisplayFor(model => model.Username)
                </span>
            </div>

            <a asp-action="ChangeUsername"
               asp-controller="Member"
               class="game-button-secondary">
                Change username
            </a>
        </div>

        <div class="game-divider"></div>

        <div class="member-profile-row">
            <div class="member-profile-info">
                <span class="game-label">
                    @Html.DisplayNameFor(model => model.Email)
                </span>
                <span class="game-text">
                    @Html.DisplayFor(model => model.Email)
                </span>
            </div>

            <a asp-action="ChangeEmail"
               asp-controller="Member"
               class="game-button-secondary">
                Change email
            </a>
        </div>

        <div class="game-divider"></div>

        <div class="member-profile-row">
            <span class="game-label">
                Password
            </span>

            <a asp-action="ChangePassword"
               asp-controller="Member"
               class="game-button-secondary">
                Change password
            </a>
        </div>

    </div>

    <div class="member-profile-navigation">
        <a asp-action="Index"
           asp-controller="Home"
           class="game-button">
            Back to Home
        </a>
    </div>

</div>
