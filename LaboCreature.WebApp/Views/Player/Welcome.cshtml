
@{
    ViewData["Title"] = "Welcome";
}

<div class="game-container">

    <!-- STEP 1: Welcome and player creation -->
    <section id="createPlayerSection" class="game-panel">

        <h1 class="game-title">Welcome, adventurer!</h1>

        <p class="game-text">
            Your adventure is about to begin.
        </p>

        <div class="game-divider"></div>

        <form id="createPlayerForm"
              asp-controller="Player"
              asp-action="CreatePlayer"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    id="createPlayerButton"
                    class="game-button">
                Create player
            </button>

        </form>

        <p id="createPlayerMessage" class="game-text" hidden></p>

    </section>


    <!-- STEP 2: Coins -->
    <section id="coinsSection" class="game-panel" hidden>

        <h2 class="game-subtitle">A little help to get started!</h2>

        <p class="game-text">
            Get a little something to help start your adventure.
        </p>

        <div class="game-divider"></div>

        <form id="getFirstCoins"
              asp-controller="Player"
              asp-action="AddFirstCoins"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    id="getFirstCoinsButton"
                    class="game-button">
                Get 100 coins
            </button>

        </form>

        <p id="getCoinsMessage" class="game-text" hidden></p>

    </section>


    <!-- STEP 3: Finished -->
    <section id="finishSection" class="game-panel" hidden>

        <h1 class="game-title">You're ready!</h1>

        <p class="game-text">
            Your adventure awaits!
        </p>

        <div class="game-divider"></div>

        <a class="game-button"
           asp-controller="Home"
           asp-action="Index">
            Start playing!
        </a>

    </section>

</div>


@section Scripts {
    <script src="~/js/playerWelcome.js"
            asp-append-version="true"></script>
}
