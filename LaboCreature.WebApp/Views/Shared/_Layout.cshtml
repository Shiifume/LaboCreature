<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaboCreature.WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="nav-banner"></div>
        <nav class="navbar">
            <div class="navbar-left">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Home" asp-action="Dashboard">Home</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Index</a>
                }
            </div>

            <div class="navbar-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div>
                        @await Component.InvokeAsync("PlayerMoney")
                    </div>

                    <a asp-controller="Member" asp-action="Details">Profile</a>

                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Auth" asp-action="Register">Register</a>
                    <a asp-area="" asp-controller="Auth" asp-action="Login">Login</a>
                }
            </div>
        </nav>
        <p>
        @TempData["message"]
        </p>

    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

<footer class="game-footer">
    <div class="footer-content">
        <span>&copy; 2026 - My Creature Game</span>
        <span class="footer-separator">|</span>
        <a asp-area="" asp-controller="Home" asp-action="Privacy">
            Privacy
        </a>
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
